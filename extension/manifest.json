{
  "manifest_version": 3,
  "name": "ChanceCart",
  "version": "0.1.0",
  "description": "A local-only proof of concept that adds a user-selected chance gate before checkout.",
  "minimum_chrome_version": "102",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "ChanceCart",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.ubereats.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
